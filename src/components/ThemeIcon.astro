---

<button id="themeToggle" aria-label="Toggle theme">
  <!-- sun: shown when override=light -->
  <svg class="icon-sun" width="22px" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white">
    <path d="m5.64 17l-.71.71a1 1 0 0 0 0 1.41a1 1 0 0 0 1.41 0l.71-.71A1 1 0 0 0 5.64 17ZM5 12a1 1 0 0 0-1-1H3a1 1 0 0 0 0 2h1a1 1 0 0 0 1-1Zm7-7a1 1 0 0 0 1-1V3a1 1 0 0 0-2 0v1a1 1 0 0 0 1 1ZM5.64 7.05a1 1 0 0 0 .7.29a1 1 0 0 0 .71-.29a1 1 0 0 0 0-1.41l-.71-.71a1 1 0 0 0-1.41 1.41Zm12 .29a1 1 0 0 0 .7-.29l.71-.71a1 1 0 1 0-1.41-1.41l-.64.71a1 1 0 0 0 0 1.41a1 1 0 0 0 .66.29ZM21 11h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 0-2Zm-9 8a1 1 0 0 0-1 1v1a1 1 0 0 0 2 0v-1a1 1 0 0 0-1-1Zm6.36-2A1 1 0 0 0 17 18.36l.71.71a1 1 0 0 0 1.41 0a1 1 0 0 0 0-1.41ZM12 6.5a5.5 5.5 0 1 0 5.5 5.5A5.51 5.51 0 0 0 12 6.5Zm0 9a3.5 3.5 0 1 1 3.5-3.5a3.5 3.5 0 0 1-3.5 3.5Z"/>
  </svg>
  <!-- moon: shown when override=dark -->
  <svg class="icon-moon" width="22px" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white">
    <path d="M21.64 13a1 1 0 0 0-1.05-.14a8.05 8.05 0 0 1-3.37.73a8.15 8.15 0 0 1-8.14-8.1a8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69a1 1 0 0 0-.36-1.05Zm-9.5 6.69A8.14 8.14 0 0 1 7.08 5.22v.27a10.15 10.15 0 0 0 10.14 10.14a9.79 9.79 0 0 0 2.1-.22a8.11 8.11 0 0 1-7.18 4.32Z"/>
  </svg>
  <!-- monitor: shown when following system (no override) -->
  <svg class="icon-system" width="22px" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white">
    <path d="M20 3H4a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h6v2H7a1 1 0 0 0 0 2h10a1 1 0 0 0 0-2h-3v-2h6a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm0 13H4V5h16z"/>
  </svg>
</button>

<style>
  #themeToggle {
    border: 0;
    background: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    padding: 0;
  }

  /* default: show system icon */
  .icon-sun  { display: none; }
  .icon-moon { display: none; }
  .icon-system { display: block; }

  /* override=light */
  #themeToggle[data-theme="light"] .icon-sun    { display: block; }
  #themeToggle[data-theme="light"] .icon-moon   { display: none; }
  #themeToggle[data-theme="light"] .icon-system { display: none; }

  /* override=dark */
  #themeToggle[data-theme="dark"] .icon-sun    { display: none; }
  #themeToggle[data-theme="dark"] .icon-moon   { display: block; }
  #themeToggle[data-theme="dark"] .icon-system { display: none; }
</style>

<script is:inline>
  // themeOverride: "light" | "dark" | null
  // null = follow system (no user choice stored)
  // Ignores legacy "theme" key written by old code.

  const STORE_KEY = "themeOverride";
  const mediaQuery = window.matchMedia("(prefers-color-scheme: dark)");

  const getSystemTheme = () => (mediaQuery.matches ? "dark" : "light");

  const applyTheme = (t) => {
    if (t === "dark") {
      document.documentElement.classList.add("dark");
    } else {
      document.documentElement.classList.remove("dark");
    }
  };

  // Sync button icon to current override state (null = system icon)
  const syncIcon = (override) => {
    const btn = document.getElementById("themeToggle");
    if (!btn) return;
    if (override === "light" || override === "dark") {
      btn.setAttribute("data-theme", override);
    } else {
      btn.removeAttribute("data-theme");
    }
  };

  // Init
  const userOverride = localStorage?.getItem(STORE_KEY);
  const override = userOverride === "light" || userOverride === "dark" ? userOverride : null;
  applyTheme(override ?? getSystemTheme());
  syncIcon(override);

  // Follow system when no override
  mediaQuery.addEventListener("change", (e) => {
    if (!localStorage?.getItem(STORE_KEY)) {
      applyTheme(e.matches ? "dark" : "light");
    }
  });

  // Cycle: system → light → dark → system
  const handleToggleClick = () => {
    const current = localStorage?.getItem(STORE_KEY);
    let next;
    if (!current) {
      next = "light";
    } else if (current === "light") {
      next = "dark";
    } else {
      // dark → back to system
      next = null;
    }

    if (next === null) {
      localStorage?.removeItem(STORE_KEY);
      applyTheme(getSystemTheme());
    } else {
      localStorage?.setItem(STORE_KEY, next);
      applyTheme(next);
    }
    syncIcon(next);
  };

  document
    .getElementById("themeToggle")
    ?.addEventListener("click", handleToggleClick);
</script>
