---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

const { frontmatter } = Astro.props;
const { id, data } = frontmatter;
const { title, pubDate, description, image } = data;
console.log("id:", id, frontmatter);
// class="shadow-md inset-shadow-2xs p-4 mb-4 rounded group-hover:stroke-white relative h-40 hover:scale-[1.005] scale-100 active:scale-100 bg-[var(--color-surface-elevated)] border border-[var(--color-border)] text-[var(--color-text)]"
---

<article class="group">
  <a href={`/posts/${id}`} class="block">
    <div class="md:w-4/5 lg:w-4/5 xl:w-4/5">
      <div>
        <p class="font-mono text-xs font-bold tracking-wider uppercase dark:text-gray-500 text-[var(--color-text-muted)]">
          {new Date(pubDate).toLocaleDateString()}
        </p>
        <h3
          class="mt-2 mb-2 text-2xl leading-tight font-bold text-gray-900 transition-colors group-hover:text-blue-600 dark:text-white dark:group-hover:text-blue-400 line-clamp-2"
        >
          {title}
        </h3>
      </div>
      <p
        class="line-clamp-2 overflow-hidden text-[13px] md:text-base leading-relaxed text-gray-600 dark:text-gray-400"
      >
        {description}
      </p>
    </div>
  </a>
  <div
    class="my-12 block border-b border-gray-100 group-last:border-0 dark:border-gray-800"
  >
  </div>
</article>

