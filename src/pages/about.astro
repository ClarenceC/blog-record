---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siGithub, siJuejin, siX } from "simple-icons";

const links = [
  {
    href: "https://github.com/ClarenceC",
    label: "GitHub",
    path: siGithub.path,
  },
  {
    href: "https://juejin.cn/user/3245414054900903",
    label: "稀土掘金",
    path: siJuejin.path,
  },
  {
    href: "https://x.com/lockshiver",
    label: "X",
    path: siX.path,
  },
];
---

<BaseLayout
  pageTitle="About Me"
  description="Clarence，写技术，也做业务前端。"
>
  <div class="about">
    <p>
      ClarenceC 十年研发工程师，熟悉 React、Vue、TypeScript、Java、Node.js 等技术
    </p>
    <p>最近在研究 Agent，对 Web3 感兴趣</p>
    <p>
      之前在广州的互联网公司工作过，失业状态，可接远程工作。
    </p>
    <div class="about-links">
      {
        links.map((link) => (
          <a href={link.href} aria-label={link.label} title={link.label}>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              role="img"
              aria-hidden="true"
            >
              <path d={link.path} />
            </svg>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .about{
    max-width: 620px;
    /* margin: 0 auto; */
  }
  .about p + p {
    margin-top: 1rem;
  }

  .about a {
    color: var(--color-link);
  }

  .about a:hover {
    color: var(--color-link-hover);
  }

  .about-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 3rem;
  }

  .about-links a {
    display: flex;
    line-height: 0;
  }

  .about-links svg {
    display: block;
    fill: currentColor;
  }
</style>
