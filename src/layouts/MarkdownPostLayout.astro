---
import BaseLayout from "./BaseLayout.astro";
// import "../styles/markdown.css";
import {
  Calendar1,
  ChevronLeft,
  ChevronRight,
  Clock,
  WholeWord,
} from "lucide-preact";
import { formatDate } from "../utils/date";

const { frontmatter, words, minutesRead, prev = null, next = null } =
  Astro.props;
const readMinutes = Math.max(1, Math.round(Number(minutesRead) || 1));
const description = frontmatter.description?.trim() ?? "";
const imageUrl = frontmatter.image?.url?.trim() ?? "";
---

<style is:global>
  .markdown {
    --md-text: #3f3f3f;
    --md-strong: #ff3502;
    --md-link: #576b95;
    --md-quote: #5b5b5b;
    --md-quote-mark: #9e9e9e;
    --md-font: Optima-Regular, Optima, PingFangSC-light, PingFangTC-light,
      "PingFang SC", Cambria, Cochin, Georgia, Times, "Times New Roman", serif;

    color: var(--md-text);
    font-family: var(--md-font);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.6;
    text-align: left;
  }

  html.dark .markdown {
    --md-text: var(--color-text);
    --md-strong: #ff7a59;
    --md-link: #9eb4d8;
    --md-quote: var(--color-text-muted);
    --md-quote-mark: var(--color-border);
  }

  .markdown h1,
  .markdown h2,
  .markdown h3,
  .markdown h4,
  .markdown h5,
  .markdown h6 {
    color: var(--md-text);
    font-family: inherit;
    font-weight: 400;
    line-height: 1.5;
  }

  /* The article has no h1; this keeps the same centered, regular-weight voice. */
  .markdown h1 {
    margin: 48px 10px 24px;
    font-size: 26px;
    text-align: center;
  }

  .markdown h2 {
    margin: 80px 10px 40px;
    font-size: 22.4px;
    text-align: center;
  }

  .markdown h3 {
    margin: 40px 10px 20px;
    font-size: 19.2px;
    font-weight: 700;
    text-align: left;
  }

  .markdown h4 {
    margin: 32px 10px 16px;
    font-size: 17px;
    font-weight: 700;
  }

  .markdown h5,
  .markdown h6 {
    margin: 24px 10px 12px;
    font-size: 16px;
    font-weight: 700;
  }

  .markdown p {
    margin: 10px;
    padding: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--md-text);
  }

  .markdown a {
    color: var(--md-link);
    font-size: inherit;
    text-decoration: none;
  }

  .markdown a:hover {
    text-decoration: underline;
  }

  .markdown strong {
    font-weight: 700;
    color: var(--md-strong);
  }

  .markdown em {
    font-style: italic;
  }

  .markdown ul,
  .markdown ol {
    margin: 10px 10px 10px 2em;
    padding: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--md-text);
  }

  .markdown ul {
    list-style-type: disc;
  }

  .markdown ol {
    list-style-type: decimal;
  }

  .markdown li {
    margin: 0.35em 0;
    color: var(--md-text);
  }

  .markdown li > p {
    margin: 0.35em 0;
  }

  .markdown blockquote {
    margin: 20px 10px;
    padding: 1px 0 1px 10px;
    color: var(--md-quote);
    font-size: 16px;
    line-height: 1.5;
    background: rgba(158, 158, 158, 0.1);
    border-left: 3px solid var(--md-quote-mark);
  }

  .markdown blockquote p {
    margin: 10px 0;
    color: inherit;
  }

  .markdown img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 20px auto;
    border-radius: 4px;
  }

  .markdown hr {
    margin: 32px 10px;
    border: 0;
    border-top: 1px solid rgba(158, 158, 158, 0.45);
  }

  /* Inline code in the article is 15px at 60% opacity, with no chip background. */
  .markdown :not(pre) > code {
    padding: 0;
    background: none;
    border-radius: 0;
    color: inherit;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 15px;
    opacity: 0.6;
  }

  .markdown pre,
  .markdown .astro-code {
    margin: 20px 10px;
    border-radius: 4px;
    font-size: 14px;
    line-height: 1.6;
    overflow-x: auto;
  }

  .markdown .astro-code span {
    font-size: 14px;
  }

  @media (max-width: 640px) {
    .markdown h1 {
      margin: 36px 0 20px;
    }

    .markdown h2 {
      margin: 48px 0 24px;
    }

    .markdown h3 {
      margin: 32px 0 16px;
    }

    .markdown h4,
    .markdown h5,
    .markdown h6,
    .markdown p,
    .markdown blockquote,
    .markdown pre,
    .markdown .astro-code,
    .markdown hr {
      margin-left: 0;
      margin-right: 0;
    }
  }
</style>

<BaseLayout
  pageTitle={frontmatter.title}
  description={description}
  image={imageUrl}
>
  <article class="w-full">
    <div class="post-meta">
      <time datetime={frontmatter.pubDate.toISOString().slice(0, 10)}>
        <Calendar1 size={14} strokeWidth={1.75} />
        {formatDate(frontmatter.pubDate)}
      </time>
      <span>
        <WholeWord size={14} strokeWidth={1.75} />
        {words} 字
      </span>
      <span>
        <Clock size={14} strokeWidth={1.75} />
        约 {readMinutes} 分钟
      </span>
    </div>
    <section class="md:mx-2 leading-[1.9]">
      {description && <p><em>{description}</em></p>}
      {
        imageUrl && (
          <img
            class="my-4"
            src={imageUrl}
            width="100%"
            alt={frontmatter.image.alt}
          />
        )
      }
      <!-- <div class="markdown"> -->
      <div class="markdown">
        <slot />
      </div>
    </section>
    <div class="tags">
      {
        frontmatter.tags.map((tag: string) => (
          <a class="tag" href={`/tags/${tag}`}>
            {tag}
          </a>
        ))
      }
    </div>
    {
      (prev || next) && (
        <nav class="post-nav" aria-label="相邻文章">
          <div>
            {prev && (
              <a class="post-nav-link" href={`/posts/${prev.id}`} rel="prev">
                <span class="post-nav-kicker">
                  <ChevronLeft size={16} strokeWidth={1.5} />
                  上一篇
                </span>
                <span class="post-nav-title">{prev.title}</span>
              </a>
            )}
          </div>
          <div>
            {next && (
              <a
                class="post-nav-link post-nav-next"
                href={`/posts/${next.id}`}
                rel="next"
              >
                <span class="post-nav-kicker">
                  下一篇
                  <ChevronRight size={16} strokeWidth={1.5} />
                </span>
                <span class="post-nav-title">{next.title}</span>
              </a>
            )}
          </div>
        </nav>
      )
    }
  </article>
</BaseLayout>
<style>
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
    margin: 2px 0 22px;
    color: var(--color-text-muted);
    font-size: 13px;
    line-height: 1;
  }

  .post-meta time,
  .post-meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .post-meta svg {
    flex: none;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 28px 10px 4px;
  }

  .tag {
    border: 1px solid color-mix(in srgb, var(--color-text-muted) 28%, transparent);
    border-radius: 999px;
    padding: 1px 8px;
    color: var(--color-text-muted);
    font-size: 12px;
    line-height: 1.7;
    text-decoration: none;
  }

  .tag:hover {
    color: var(--color-link);
    border-color: color-mix(in srgb, var(--color-link) 40%, transparent);
  }

  .tag:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 28px 10px 8px;
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    height: 100%;
    padding: 12px 14px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text);
    text-decoration: none;
  }

  .post-nav-link:hover {
    border-color: var(--color-link);
    color: var(--color-link);
  }

  .post-nav-link:focus-visible {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }

  .post-nav-next {
    align-items: flex-end;
    text-align: right;
  }

  .post-nav-kicker {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    color: var(--color-text-muted);
    font-size: 12px;
    line-height: 1;
  }

  .post-nav-title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-size: 14px;
    line-height: 1.45;
  }

  @media (max-width: 640px) {
    .tags,
    .post-nav {
      margin-left: 0;
      margin-right: 0;
    }
  }
</style>
