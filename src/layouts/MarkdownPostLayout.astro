---
import BaseLayout from "./BaseLayout.astro";
// import "../styles/markdown.css";
import {
  Calendar1,
  CircleUserRound,
  Clock,
  MessageCircleMore,
} from "lucide-preact";
import { formatDate } from "../utils/date";

const { frontmatter, words, minutesRead } = Astro.props;
---

<style is:global>
  .markdown {
    --md-text: #3f3f3f;
    --md-strong: #ff3502;
    --md-link: #576b95;
    --md-quote: #5b5b5b;
    --md-quote-mark: #9e9e9e;
    --md-font: Optima-Regular, Optima, PingFangSC-light, PingFangTC-light,
      "PingFang SC", Cambria, Cochin, Georgia, Times, "Times New Roman", serif;

    color: var(--md-text);
    font-family: var(--md-font);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.6;
    text-align: left;
  }

  html.dark .markdown {
    --md-text: var(--color-text);
    --md-strong: #ff7a59;
    --md-link: #9eb4d8;
    --md-quote: var(--color-text-muted);
    --md-quote-mark: var(--color-border);
  }

  .markdown h1,
  .markdown h2,
  .markdown h3,
  .markdown h4,
  .markdown h5,
  .markdown h6 {
    color: var(--md-text);
    font-family: inherit;
    font-weight: 400;
    line-height: 1.5;
  }

  /* The article has no h1; this keeps the same centered, regular-weight voice. */
  .markdown h1 {
    margin: 48px 10px 24px;
    font-size: 26px;
    text-align: center;
  }

  .markdown h2 {
    margin: 80px 10px 40px;
    font-size: 22.4px;
    text-align: center;
  }

  .markdown h3 {
    margin: 40px 10px 20px;
    font-size: 19.2px;
    font-weight: 700;
    text-align: left;
  }

  .markdown h4 {
    margin: 32px 10px 16px;
    font-size: 17px;
    font-weight: 700;
  }

  .markdown h5,
  .markdown h6 {
    margin: 24px 10px 12px;
    font-size: 16px;
    font-weight: 700;
  }

  .markdown p {
    margin: 10px;
    padding: 0;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--md-text);
  }

  .markdown a {
    color: var(--md-link);
    font-size: inherit;
    text-decoration: none;
  }

  .markdown a:hover {
    text-decoration: underline;
  }

  .markdown strong {
    font-weight: 700;
    color: var(--md-strong);
  }

  .markdown em {
    font-style: italic;
  }

  .markdown ul,
  .markdown ol {
    margin: 10px 10px 10px 2em;
    padding: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--md-text);
  }

  .markdown ul {
    list-style-type: disc;
  }

  .markdown ol {
    list-style-type: decimal;
  }

  .markdown li {
    margin: 0.35em 0;
    color: var(--md-text);
  }

  .markdown li > p {
    margin: 0.35em 0;
  }

  .markdown blockquote {
    margin: 20px 10px;
    padding: 1px 0 1px 10px;
    color: var(--md-quote);
    font-size: 16px;
    line-height: 1.5;
    background: rgba(158, 158, 158, 0.1);
    border-left: 3px solid var(--md-quote-mark);
  }

  .markdown blockquote p {
    margin: 10px 0;
    color: inherit;
  }

  .markdown img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 20px auto;
    border-radius: 4px;
  }

  .markdown hr {
    margin: 32px 10px;
    border: 0;
    border-top: 1px solid rgba(158, 158, 158, 0.45);
  }

  /* Inline code in the article is 15px at 60% opacity, with no chip background. */
  .markdown :not(pre) > code {
    padding: 0;
    background: none;
    border-radius: 0;
    color: inherit;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 15px;
    opacity: 0.6;
  }

  .markdown pre,
  .markdown .astro-code {
    margin: 20px 10px;
    border-radius: 4px;
    font-size: 14px;
    line-height: 1.6;
    overflow-x: auto;
  }

  .markdown .astro-code span {
    font-size: 14px;
  }

  @media (max-width: 640px) {
    .markdown h1 {
      margin: 36px 0 20px;
    }

    .markdown h2 {
      margin: 48px 0 24px;
    }

    .markdown h3 {
      margin: 32px 0 16px;
    }

    .markdown h4,
    .markdown h5,
    .markdown h6,
    .markdown p,
    .markdown blockquote,
    .markdown pre,
    .markdown .astro-code,
    .markdown hr {
      margin-left: 0;
      margin-right: 0;
    }
  }
</style>

<BaseLayout
  pageTitle={frontmatter.title}
  description={frontmatter.description}
  image={frontmatter.image.url}
>
  <article class="md:w-2xl w-full">
    <div class="flex gap-2 md:gap-5 text-sm items-center mt-2 mb-5 opacity-30">
      <time
        class="flex items-center"
        datetime={frontmatter.pubDate.toISOString().slice(0, 10)}
      >
        <Calendar1 class="mr-2" strokeWidth={1.5} />
        {formatDate(frontmatter.pubDate)}
      </time>
      <address class="flex items-center">
        <CircleUserRound class="mr-2" strokeWidth={1.5} />
        <span class="opacity-100">{frontmatter.author}</span>
      </address>
      <span class="flex items-center">
        <MessageCircleMore class="mr-2" strokeWidth={1.5} />
        {words}
      </span>
      <span class="flex items-center">
        <Clock class="mr-2" strokeWidth={1.5} />
        {`${minutesRead}m`}
      </span>
    </div>
    <section class="md:mx-2 leading-[1.9]">
      <p><em>{frontmatter.description}</em></p>
      <img
        class="my-4"
        src={frontmatter.image.url}
        width="100%"
        alt={frontmatter.image.alt}
      />
      <!-- <div class="markdown"> -->
      <div class="markdown">
        <slot />
      </div>
    </section>
    <div class="tags">
      {
        frontmatter.tags.map((tag: string) => (
          <p class="tag">
            <a href={`/tags/${tag}`}>{tag}</a>
          </p>
        ))
      }
    </div>
  </article>
</BaseLayout>
<style>
  a {
    color: var(--color-link);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .tag {
    margin: 0.25em;
    border: dotted 1px var(--color-border);
    border-radius: 0.5em;
    padding: 0.5em 1em;
    font-size: 1.15em;
    background-color: var(--color-surface-elevated);
  }
</style>
